<div class="max-w-4xl mx-auto">
  <div class="mb-8 flex justify-between items-center">
    <h2 class="text-2xl font-bold" data-i18n="Test Report">Test Report</h2>
    <div class="space-x-3">
      <button onclick="window.print()" class="px-4 py-2 rounded-lg font-medium bg-slate-200 hover:bg-slate-300 transition-all text-sm">
        <span data-i18n="Print">🖨️ Print</span>
      </button>
      <a href="/" class="px-4 py-2 rounded-lg font-medium bg-slate-200 hover:bg-slate-300 transition-all text-sm">
        <span data-i18n="Dashboard">🏠 Dashboard</span>
      </a>
    </div>
  </div>

  <!-- Summary Card -->
  <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 mb-6">
    <h3 class="font-bold text-lg mb-4" data-i18n="Summary">📋 Summary</h3>
  <div class="grid grid-cols-2 gap-4 text-sm">
    <div><strong data-i18n="Report ID:">Report ID:</strong> <%= report.id %></div>
    <div><strong data-i18n="Run ID:">Run ID:</strong> <code><%= report.run_id %></code></div>
    <div><strong data-i18n="Total Requests:">Total Requests:</strong> <%= report.total_requests %></div>
    <div><strong data-i18n="Avg Latency:">Avg Latency:</strong> <%= (report.avg_latency / 10).toFixed(2) %>ms</div>
    <div><strong data-i18n="P95 Latency:">P95 Latency:</strong> <%= (report.p95_latency / 10).toFixed(2) %>ms</div>
    <div><strong data-i18n="P99 Latency:">P99 Latency:</strong> <%= (report.p99_latency / 10).toFixed(2) %>ms</div>
    <div><strong data-i18n="Error Rate:">Error Rate:</strong> <%= (report.error_rate / 10).toFixed(2) + '%' %></div>
    <!-- <div><strong data-i18n="Peak CPU:">Peak CPU:</strong> <%= report.peak_cpu + '%' %></div>
    <div><strong data-i18n="Peak RAM:">Peak RAM:</strong> <%= report.peak_ram + '%' %></div> -->
  </div>
  </div>

  <!-- Recommendations -->
  <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 mb-6">
    <h3 class="font-bold text-lg mb-4" data-i18n="Recommendations">💡 Recommendations</h3>
    <% if (report.recommendations && report.recommendations !== "") { %>
      <ul class="list-disc list-inside space-y-2">
        <li><%= report.recommendations %></li>
      </ul>
    <% } else { %>
      <p>No recommendations available.</p>
    <% } %>
  </div>

  <!-- Result Badge -->
  <div class="text-center py-6">
    <div class="inline-block px-6 py-3 bg-emerald-50 text-emerald-800 rounded-xl font-medium" data-i18n="Test Completed Successfully">
      ✅ Test Completed Successfully
    </div>
  </div>
</div>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GoStresser</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'JetBrains Mono', system-ui, sans-serif; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900">
  <div class="min-h-screen flex flex-col">

    <!-- ✅ Navigation Header -->
    <header class="bg-white shadow-sm border-b border-slate-200">
      <div class="container mx-auto px-4 py-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-8">
            <h1 class="text-2xl font-bold text-emerald-600">GoStresser</h1>
            <nav class="hidden md:flex space-x-1">
              <a href="/" class="px-3 py-2 rounded-md text-sm font-medium transition-colors <%= (locals.path === '/' ? 'bg-emerald-100 text-emerald-700' : 'hover:bg-slate-200') %>" data-i18n="Dashboard">Dashboard</a>
              <a href="/scenario/new" class="px-3 py-2 rounded-md text-sm font-medium transition-colors <%= (locals.path === '/scenario/new' ? 'bg-emerald-100 text-emerald-700' : 'hover:bg-slate-200') %>" data-i18n="Create Test">Create Test</a>
              <a href="#" class="px-3 py-2 rounded-md text-sm font-medium transition-colors hover:bg-slate-200" data-i18n="Documentation">Documentation</a>
            </nav>
          </div>
          <div class="flex items-center space-x-4">
            <div class="text-sm text-slate-500" data-i18n="Version">v1.0.0</div>
            <!-- ✅ Language Toggle -->
            <button id="langToggle" class="text-sm font-medium text-slate-600 hover:text-slate-900 transition px-3 py-1 rounded">
              🌐 EN
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow container mx-auto px-4 py-8">
      <%- body %>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-6">
      <div class="container mx-auto px-4 text-center text-slate-500 text-sm">
        <span data-i18n="Footer">© 2025 GoStresser · Built with Go & Node.js · For educational use</span>
      </div>
    </footer>

  </div>

  <script>
  // ✅ Translation dictionary
  const translations = {
    en: {
      // Navigation
      'Dashboard': 'Dashboard',
      'Create Test': 'Create Test',
      'Documentation': 'Documentation',
      'Version': 'v1.0.0',
      'Footer': '© 2025 GoStresser · Built with Go & Node.js · For educational use',

      // Dashboard
      'Scenarios': 'Scenarios',
      'New Scenario': 'New Scenario',
      'Running:': 'Running:',
      'Run ID:': 'Run ID:',
      'RPS': 'RPS',
      'Latency': 'Latency',
      'CPU': 'CPU',
      'RAM': 'RAM',
      'Completed': 'Completed',
      'Stop Test': 'Stop Test',
      'Rerun Test': 'Rerun Test',
      'View Report': 'View Report',
      'Test Report': 'Test Report',
      'Print': 'Print',
      'Summary': 'Summary',
      'Recommendations': 'Recommendations',
      'Total Requests': 'Total Requests',
      'Avg Latency': 'Avg Latency',
      'Error Rate': 'Error Rate',
      'Peak CPU': 'Peak CPU',
      'Test Completed Successfully': 'Test Completed Successfully',
      'Scenario Name': 'Scenario Name',
      'Target URL': 'Target URL',
      'Method': 'Method',
      'Duration (seconds)': 'Duration (seconds)',
      'Monitor Server': 'Monitor Server',
      'Save & Run Later': 'Save & Run Later',
      'Requests per Second (RPS)': 'Requests per Second (RPS)',
      'Latency (ms)': 'Latency (ms)',
      'CPU Usage (%)': 'CPU Usage (%)',
      'RAM Usage (%)': 'RAM Usage (%)',
    },
    ru: {
      // Navigation
      'Dashboard': 'Панель управления',
      'Create Test': 'Создать тест',
      'Documentation': 'Документация',
      'Version': 'v1.0.0',
      'Footer': '© 2025 GoStresser · Создано с Go & Node.js · Для образовательного использования',

      // Dashboard
      'Scenarios': 'Сценарии',
      'New Scenario': 'Новый сценарий',
      'Running:': 'Запущен:',
      'Run ID:': 'ID запуска:',
      'RPS': 'Запросов/с',
      'Latency': 'Задержка',
      'CPU': 'ЦПУ',
      'RAM': 'ОЗУ',
      'Completed': 'Завершено',
      'Stop Test': 'Остановить тест',
      'Rerun Test': 'Перезапустить тест',
      'View Report': 'Посмотреть отчёт',
      'Test Report': 'Отчёт о тесте',
      'Print': 'Печать',
      'Summary': 'Сводка',
      'Recommendations': 'Рекомендации',
      'Total Requests': 'Всего запросов',
      'Avg Latency': 'Средняя задержка',
      'Error Rate': 'Частота ошибок',
      'Peak CPU': 'Пиковое ЦПУ',
      'Test Completed Successfully': 'Тест успешно завершён',
      'Scenario Name': 'Название сценария',
      'Target URL': 'Целевой URL',
      'Method': 'Метод',
      'Duration (seconds)': 'Длительность (сек)',
      'Monitor Server': 'Мониторить сервер',
      'Save & Run Later': 'Сохранить и запустить позже',
      'Requests per Second (RPS)': 'Запросов в секунду (RPS)',
      'Latency (ms)': 'Задержка (мс)',
      'CPU Usage (%)': 'Использование ЦПУ (%)',
      'RAM Usage (%)': 'Использование ОЗУ (%)',
    }
  };

    // ✅ Get saved language or default to 'en'
    let currentLang = localStorage.getItem('userLang') || 'en';

    // ✅ Translate all elements with data-i18n attribute
    function translatePage(lang) {
    document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (translations[lang] && translations[lang][key]) {
        if (el.placeholder) {
            el.placeholder = translations[lang][key];
        } else {
            el.textContent = translations[lang][key];
        }
        }
    });

    // Update button
    const toggleBtn = document.getElementById('langToggle');
    if (toggleBtn) {
        toggleBtn.textContent = `🌐 ${lang.toUpperCase()}`;
    }

    currentLang = lang;
    localStorage.setItem('userLang', lang); // ✅ Save to localStorage
    }

    // ✅ Re-translate the page (useful after dynamic DOM updates)
    function retranslate() {
    translatePage(currentLang);
    }

    // ✅ Toggle language
    document.addEventListener('DOMContentLoaded', () => {
    // Apply saved language
    translatePage(currentLang);

    const toggleBtn = document.getElementById('langToggle');
    if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
        const newLang = currentLang === 'en' ? 'ru' : 'en';
        translatePage(newLang);
        });
    }
    });

    // ✅ Expose retranslate globally for dynamic content
    window.retranslate = retranslate;
  </script>

</body>
</html>
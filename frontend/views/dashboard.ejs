<div class="flex justify-between items-center mb-6">
  <h2 class="text-2xl font-bold" data-i18n="Scenarios">Scenarios</h2>
  <a href="/scenario/new" class="px-4 py-2 rounded-lg font-medium transition-all bg-emerald-500 text-white hover:bg-emerald-600">
    <span data-i18n="New Scenario">+ New Scenario</span>
  </a>
</div>

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  <% scenarios.forEach(scenario => { %>
    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
      <h3 class="font-bold text-lg"><%= scenario.name %></h3>
      <p class="text-sm text-slate-600 mt-1"><%= scenario.method %> <%= scenario.target %></p>
      <div class="mt-4 text-sm">
        <span class="inline-block bg-slate-100 px-2 py-1 rounded" data-i18n="RPS">RPS: <%= scenario.rps %></span>
        <span class="inline-block bg-slate-100 px-2 py-1 rounded ml-2" data-i18n="Duration (seconds)">Duration: <%= scenario.duration %>s</span>
      </div>
      <a href="/run/<%= scenario.id %>" class="px-4 py-2 rounded-lg font-medium transition-all bg-slate-200 hover:bg-slate-300 mt-4 w-full block text-center">
        <span data-i18n="Run Test">Run Test</span>
      </a>
    </div>
  <% }) %>
</div>
<!-- DEBUG: live_test.ejs loaded at <%= new Date().toISOString() %> -->
<!-- Scenario: <%= scenario?.name || 'Unknown' %> | Run ID: <%= runId %> -->

<h2 class="text-2xl font-bold mb-2">
  <span data-i18n="Running:">Running:</span> 
  <span class="text-emerald-600"><%= scenario.name %></span>
</h2>
<p class="text-slate-600 mb-6">
  <span data-i18n="Run ID:">Run ID:</span> <code><%= runId %></code> · 
  <span id="timer" class="font-mono">0s / <%= scenario.duration %>s</span>
</p>

<!-- Fixed height container -->
<div class="bg-slate-100 rounded-xl p-4 mb-6" style="height: 450px; overflow: hidden;">
  <div class="space-y-4">
    <!-- RPS Chart -->
<div class="bg-white p-3 rounded-lg shadow-sm border border-slate-200" style="height: 90px;">
  <div class="flex justify-between items-center mb-1">
    <h3 class="font-bold text-xs" data-i18n="RPS">📈 RPS</h3>
    <span id="rpsValue" class="text-lg font-bold text-emerald-600">0</span>
  </div>
  <div class="h-[44px] w-full mt-1"> <!-- ↓ reduced height, added top margin -->
    <canvas id="rpsChart" class="w-full h-full"></canvas>
  </div>
</div>

<!-- Latency Chart -->
<div class="bg-white p-3 rounded-lg shadow-sm border border-slate-200" style="height: 90px;">
  <div class="flex justify-between items-center mb-1">
    <h3 class="font-bold text-xs" data-i18n="Latency">⏱️ Latency</h3>
    <span id="latencyValue" class="text-lg font-bold text-violet-600">0ms</span>
  </div>
  <div class="h-[44px] w-full mt-1">
    <canvas id="latencyChart" class="w-full h-full"></canvas>
  </div>
</div>

<!-- CPU Chart -->
<div class="bg-white p-3 rounded-lg shadow-sm border border-slate-200" style="height: 90px;">
  <div class="flex justify-between items-center mb-1">
    <h3 class="font-bold text-xs" data-i18n="CPU">🖥️ CPU</h3>
    <span id="cpuValue" class="text-lg font-bold text-amber-600">0%</span>
  </div>
  <div class="h-[44px] w-full mt-1">
    <canvas id="cpuChart" class="w-full h-full"></canvas>
  </div>
</div>

<!-- RAM Chart -->
<div class="bg-white p-3 rounded-lg shadow-sm border border-slate-200" style="height: 90px;">
  <div class="flex justify-between items-center mb-1">
    <h3 class="font-bold text-xs" data-i18n="RAM">💾 RAM</h3>
    <span id="ramValue" class="text-lg font-bold text-red-600">0%</span>
  </div>
  <div class="h-[44px] w-full mt-1">
    <canvas id="ramChart" class="w-full h-full"></canvas>
  </div>
</div>
  </div>
</div>

<div class="mt-6 flex justify-center">
  <div id="controlButtons" class="flex space-x-4">
    <button id="stopButton" class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white rounded-lg font-medium transition">
      <span data-i18n="Stop Test">■ Stop Test</span>
    </button>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  console.log('✅ DOM loaded - initializing charts in 200ms...');

  setTimeout(() => {
    function createChart(canvasId, color, suggestedMax = 100) {
      const canvas = document.getElementById(canvasId);
      if (!canvas) {
        console.error(`❌ Canvas #${canvasId} not found in DOM!`);
        return null;
      }

      const ctx = canvas.getContext('2d');
      return new Chart(ctx, {
        type: 'line',
        data: {
          labels: [],
          datasets: [{
            data: [],
            borderColor: color,
            backgroundColor: color + '20', // ~12% opacity
            borderWidth: 2,
            tension: 0.3,
            fill: true,
            pointRadius: 0,
            pointHitRadius: 8
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              beginAtZero: true,
              suggestedMax: suggestedMax,
              grid: { color: 'rgba(0,0,0,0.03)' },
              ticks: {
                font: { size: 9 },
                callback: (val) => (val % 20 === 0 ? val : '')
              }
            },
            x: {
              grid: { display: false },
              ticks: { display: false }
            }
          },
          plugins: {
            legend: { display: false },
            tooltip: {
              enabled: true, // ← Keep tooltip enabled for debugging & usability
              mode: 'index',
              intersect: false,
              callbacks: {
                label: (ctx) => ` ${ctx.parsed.y.toFixed(1)}%`
              }
            }
          },
          animation: { duration: 0 },
          interaction: {
            mode: 'nearest',
            axis: 'x',
            intersect: false
          }
        }
      });
    }

    // Initialize charts — RPS/Latency use dynamic scale; CPU/RAM capped at 100
    const rpsChart = createChart('rpsChart', '#10b981', 200);     // RPS: allow higher
    const latencyChart = createChart('latencyChart', '#8b5cf6', 500); // Latency: up to 500ms
    const cpuChart = createChart('cpuChart', '#f59e0b', 100);     // CPU: % → max 100
    const ramChart = createChart('ramChart', '#ef4444', 100);     // RAM: % → max 100

    if (!rpsChart || !latencyChart || !cpuChart || !ramChart) {
      console.error('❌ One or more charts failed to initialize');
      return;
    }

    console.log('✅ All charts initialized successfully');

    // Elements
    const timerEl = document.getElementById('timer');
    const valueEls = {
      rps: document.getElementById('rpsValue'),
      latency: document.getElementById('latencyValue'),
      cpu: document.getElementById('cpuValue'),
      ram: document.getElementById('ramValue')
    };

    const TEST_DURATION = "<%= scenario.duration %>";
    const MAX_DATA_POINTS = Math.min(24, Math.max(8, TEST_DURATION));
    let timeElapsed = 0;

    // ✅ Helper to safely extract % values
    const getPercent = (val) => Math.min(100, Math.max(0, parseFloat(val) || 0));

    const stopButton = document.getElementById('stopButton');
    if (stopButton) {
      stopButton.addEventListener('click', () => {
        if (window.updateInterval) {
          clearInterval(window.updateInterval);
        }
        timerEl.textContent = `⏹️ Stopped at ${timeElapsed}s`;
        timerEl.classList.add('text-amber-600');

        const buttonContainer = document.getElementById('controlButtons');
        if (buttonContainer) {
          buttonContainer.innerHTML = `
            <a href="/run/<%= scenario.id %>" class="px-4 py-2 bg-emerald-500 hover:bg-emerald-600 text-white rounded-lg font-medium transition flex items-center space-x-2">
              <span>🔄</span>
              <span data-i18n="Rerun Test">Rerun Test</span>
            </a>
          `;

          if (typeof window.retranslate === 'function') {
            setTimeout(() => window.retranslate(), 0);
          }
        }
      });
    }

    const updateCharts = async () => {
      try {
        const data = await fetch("<%= metricsUrl %>?_t=" + Date.now()).then(r => r.json());

        // 🔍 Debug: log missing fields
        if (data.cpu == null) console.warn('⚠️ CPU data missing in response');
        if (data.ram == null) console.warn('⚠️ RAM data missing in response');

        // Update live values
        const rps = data.rps || data.requests_per_second || 0;
        const latency = (data.avg_latency || data.latency || 0) / 10;
        const cpu = getPercent(data.cpu || data.cpu_usage);
        const ram = getPercent(data.ram || data.ram_usage);

        valueEls.rps.textContent = Math.round(rps);
        valueEls.latency.textContent = latency.toFixed(1) + 'ms';
        valueEls.cpu.textContent = cpu.toFixed(1) + '%';
        valueEls.ram.textContent = ram.toFixed(1) + '%';

        // Update charts
        const chartData = [rps, latency, cpu, ram];
        [rpsChart, latencyChart, cpuChart, ramChart].forEach((chart, i) => {
          if (chart.data.labels.length >= MAX_DATA_POINTS) {
            chart.data.labels.shift();
            chart.data.datasets[0].data.shift();
          }
          chart.data.labels.push('');
          chart.data.datasets[0].data.push(chartData[i]);
          chart.update('none'); // 'none' = no animation
        });

        // Timer update
        timeElapsed = Math.min(
          data.time_elapsed ?? data.second ?? data.timeElapsed ?? (timeElapsed + 1),
          TEST_DURATION
        );
        timerEl.textContent = `${timeElapsed}s / ${TEST_DURATION}s`;

        if (timeElapsed >= TEST_DURATION) {
          clearInterval(window.updateInterval);
          timerEl.textContent = `✅ Completed (${TEST_DURATION}s)`;
          timerEl.classList.add('text-emerald-600');

          const btns = document.getElementById('controlButtons');
          if (btns) {
            btns.innerHTML = `
              <a href="/run/<%= scenario.id %>" class="px-4 py-2 bg-emerald-500 hover:bg-emerald-600 text-white rounded-lg font-medium transition flex items-center space-x-2">
                <span>🔄</span><span data-i18n="Rerun Test">Rerun Test</span>
              </a>
            `;
            window.retranslate?.();
          }
        }
      } catch (err) {
        console.error('❌ Metrics fetch failed:', err.message || err);
        timeElapsed = Math.min(timeElapsed + 1, TEST_DURATION);
        timerEl.textContent = `${timeElapsed}s / ${TEST_DURATION}s`;
      }
    };

    updateCharts();
    window.updateInterval = setInterval(updateCharts, 1000);
  }, 200);
});
</script>